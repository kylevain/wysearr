PUID=1000
PGID=1000
TZ=Pacific/Honolulu
WYSEARR_BIND_ADDRESS=192.168.4.86
MEDIA_ROOT=/mnt/media
TORRENT_ROOT=/home/wyseadmin/homelab/state/torrents
QBITTORRENT_PORT=8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=
# qBittorrent is fail-closed behind Gluetun. CA Vancouver is the nearest
# currently port-forward-capable PIA region for Hawaii; keep OpenVPN on UDP.
VPN_SERVICE_PROVIDER=private internet access
OPENVPN_USER=
OPENVPN_PASSWORD=
VPN_SERVER_REGIONS=CA Vancouver
OPENVPN_PROTOCOL=udp
# ABBA reuses the two QBITTORRENT_* credentials above; do not duplicate them.
ABBA_ENABLED=false
ABBA_URL=http://abba:5078
ABBA_ABB_HOSTNAME=audiobookbay.lu
ABBA_PAGE_LIMIT=1
ABBA_TIMEOUT_SECONDS=30
ABBA_SEARCH_LIMIT=10
HUEY_ABBA_MINIMUM_CONFIDENCE=0.82
HUEY_ABBA_RUNNER_UP_GAP=0.08
ABBA_SEARCH_CACHE_SECONDS=300
ABBA_SEARCH_MIN_INTERVAL_SECONDS=2
ABBA_RESULT_TTL_SECONDS=86400
ABBA_HTTP_TIMEOUT_SECONDS=15
PROWLARR_PORT=9696
PROWLARR_SEARCH_CONNECT_TIMEOUT_SECONDS=5
PROWLARR_SEARCH_READ_TIMEOUT_SECONDS=90
PROWLARR_SEARCH_ATTEMPTS=2
PROWLARR_SEARCH_RETRY_DELAY_SECONDS=1
SABNZBD_ADMIN_PORT=8085
SABNZBD_ADMIN_USERNAME=wyseadmin
SABNZBD_ADMIN_PASSWORD=
WYSEARR_USENET_ENABLED=false
USENET_SERVER_HOST=
USENET_SERVER_PORT=563
USENET_SERVER_SSL=true
USENET_SERVER_USERNAME=
USENET_SERVER_PASSWORD=
USENET_SERVER_CONNECTIONS=
USENET_SERVER_RETENTION=0
NEWZNAB_INDEXER_NAME=WyseARR Books
NEWZNAB_BASE_URL=
NEWZNAB_API_PATH=/api
NEWZNAB_API_KEY=
# Huey tries ebook acquisition backends serially in this exact production
# order. The compatibility owner must match the first backend; it does not
# disable fallback. Both services remain enabled so a safe pre-mutation miss or
# outage can advance without asking the Discord user to resubmit.
EBOOK_ACQUISITION_BACKENDS=lazylibrarian,shelfarr
EBOOK_ACQUISITION_OWNER=lazylibrarian
LAZYLIBRARIAN_ENABLED=true
LAZYLIBRARIAN_ADMIN_PORT=5299
LAZYLIBRARIAN_URL=http://lazylibrarian:5299
LAZYLIBRARIAN_API_KEY=
LAZYLIBRARIAN_TIMEOUT_SECONDS=30
LAZYLIBRARIAN_SEARCH_LIMIT=10
LAZYLIBRARIAN_METADATA_SOURCE=OpenLibrary
HUEY_LAZYLIBRARIAN_MINIMUM_CONFIDENCE=0.80
HUEY_LAZYLIBRARIAN_RUNNER_UP_GAP=0.05
SHELFARR_ADMIN_PORT=5056
SHELFARR_ADMIN_USERNAME=wyseadmin
SHELFARR_ADMIN_PASSWORD=
SHELFARR_CHOWN_ON_START=never
SHELFARR_ENABLED=true
SHELFARR_URL=http://shelfarr
SHELFARR_API_TOKEN=
SHELFARR_TIMEOUT_SECONDS=20
SHELFARR_SEARCH_LIMIT=10
SHELFARR_LANGUAGE=en
HUEY_SHELFARR_MINIMUM_CONFIDENCE=0.80
HUEY_SHELFARR_RUNNER_UP_GAP=0.05
HUEY_SELECTION_TTL_SECONDS=900
SONARR_PORT=8989
RADARR_PORT=7878
LIDARR_PORT=8686
WHISPARR_PORT=6969
BAZARR_PORT=6767
DISCORD_BOT_TOKEN=
PROWLARR_API_KEY=
SONARR_API_KEY=
RADARR_API_KEY=
LIDARR_API_KEY=
WHISPARR_API_KEY=
BOOKBOT_POLL_SECONDS=60
TORRENT_RETENTION_DAYS=14
